# ============================================================
# Server 2 — staging/test stack, isolated from production
#
# Usage:
#   cp .env.prod3.example .env.prod3
#   # Edit passwords/secrets before first run.
#   docker compose -f docker-compose.prod3.yml up -d --build
#
# Nginx/Baota for test.dkby.com:
#   proxy_pass http://127.0.0.1:3001
#
# This stack starts its own PostgreSQL + Redis containers, so testing new
# code here will not write to Server 1 production database/Redis.
# ============================================================

POSTGRES_USER=starNex
POSTGRES_PASSWORD=prLYJxWwZTGcthjG
POSTGRES_DB=starNex

REDIS_PASSWORD=prLYJxWwZTGcthjG

# App connects to the staging containers in docker-compose.prod3.yml.
SQL_DSN=postgresql://starNex:prLYJxWwZTGcthjG@postgres-staging:5432/starNex
REDIS_CONN_STRING=redis://:prLYJxWwZTGcthjG@redis-staging:6379/0

# If you restore a production DB copy into staging, SESSION_SECRET and
# CRYPTO_SECRET must match production to decrypt existing encrypted data.
# For an empty staging DB, use unique random values.
SESSION_SECRET=CHANGE_ME_staging_session_secret
CRYPTO_SECRET=CHANGE_ME_staging_crypto_secret

# Staging owns its isolated test database, so it can run migrations.
NODE_TYPE=master
NODE_NAME=xingyuapi-staging-2

TRUSTED_REDIRECT_DOMAINS=xingyuapi.com,dkby.com,test.dkby.com
SYNC_FREQUENCY=60

# PORT is inside the container. Host port 3001 is configured in compose.
PORT=3000

# STREAMING_TIMEOUT=300
