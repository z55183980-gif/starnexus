# Copy to .env on the server before: docker compose -f docker-compose.prod.yml up -d
#   cp .env.prod.example .env
#
# Secrets belong in .env only — do not put real passwords in this example file.

# PostgreSQL (Scheme A — must match postgres service / your PG instance)
POSTGRES_USER=newapi
POSTGRES_PASSWORD=CHANGE_ME_postgres_strong_password
POSTGRES_DB=new-api

# Redis
REDIS_PASSWORD=CHANGE_ME_redis_strong_password

# Application secrets (required in production)
# Generate: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_session_secret
CRYPTO_SECRET=CHANGE_ME_crypto_secret

# Optional
NODE_NAME=xingyuapi-prod-1
TRUSTED_REDIRECT_DOMAINS=xingyuapi.com
SYNC_FREQUENCY=60

# STREAMING_TIMEOUT=300
