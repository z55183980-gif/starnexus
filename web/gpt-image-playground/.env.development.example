# 独立开发用（复制为 .env.local 时可选）
# 日常 dev 通常不需要任何 env；留空则 base 为 ./，在 UI 或 URL 中配置 API。

# 若需固定默认 API（完整 URL）：
# VITE_DEFAULT_API_URL=https://your-gateway.example.com/v1

# 仅嵌入 StarNexus 构建时使用（由 sync 脚本自动生成，勿用于 npm run dev）：
# VITE_BASE=/image-playground/
# VITE_SHOW_DEFAULT_CONFIG_ONLY=true
# VITE_API_PROXY_AVAILABLE=false
